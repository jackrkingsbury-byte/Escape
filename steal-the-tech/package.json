{
  "name": "steal-the-tech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "STEAL THE TECH — an online collection, base-building, trading and raiding game.",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "catalog": "node scripts/gen-catalog.mjs",
    "test:sql": "node scripts/test-sql.mjs",
    "test:pglite": "node scripts/test-pglite.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test": "npm run test:sql && npm run test:pglite"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@supabase/supabase-js": "^2.117.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pg": "^8.16.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.0"
  }
}
