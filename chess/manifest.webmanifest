{
  "name": "Chess Lens — screenshot to best move",
  "short_name": "Chess Lens",
  "description": "Scan your screen or a screenshot of any chessboard and get Stockfish's best move, on your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16181d",
  "theme_color": "#16181d",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Play vs Stockfish", "short_name": "Play", "url": "./play.html", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Scan a board", "short_name": "Scan", "url": "./", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "image", "accept": ["image/*"] }] }
  }
}
